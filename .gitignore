# Large/derived audio: full-quality WAVs are attached to GitHub Releases instead
*.wav
auditions/
__pycache__/
*.pyc
.venv/
.DS_Store

# Raw stock footage: licensed for use in our videos, not for redistribution (repo is public)
episodes/*/footage/

# Voiceover audio and rendered video: large, and unpublished episodes stay private (repo is public)
episodes/*/voiceover/*.mp3
episodes/*/render/

# Music beds (CC-BY files; credits are in episodes/*/music/CREDITS.md)
episodes/*/music/*.mp3
docs/templates/*.jpg
episodes/*/tracks/*.ref.jpg
